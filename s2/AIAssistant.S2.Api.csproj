<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AIAssistant.S2.Api</RootNamespace>
  </PropertyGroup>

  <!--
    S2 · Moat — the qualitative agent, built ON the reusable Agent Harness (Harness/).
    Self-contained: Domain/ (moat draft types), Analysis/ (the reward), Harness/ (fast loop +
    lesson memory), Agent/ (model + agent). Runs offline via a deterministic mock model when
    S2_LLM_BASE_URL is unset; points at any OpenAI-compatible Azure AI Foundry deployment when set.
  -->

  <ItemGroup>
    <Content Update="examples\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\shared\AIAssistant.AgentHarness\AIAssistant.AgentHarness.csproj" />
    <ProjectReference Include="..\shared\AIAssistant.AgentHarness.Cosmos\AIAssistant.AgentHarness.Cosmos.csproj" />
  </ItemGroup>

</Project>
