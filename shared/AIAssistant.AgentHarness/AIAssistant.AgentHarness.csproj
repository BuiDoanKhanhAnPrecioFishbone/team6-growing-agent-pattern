<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AIAssistant.Harness</RootNamespace>
    <!-- NuGet packaging so other repos can consume the harness (dotnet pack). -->
    <Version>0.1.0</Version>
    <Authors>team6</Authors>
    <Description>The Growing-Agent harness: fast loop + reward contract + self-refining semantic lesson memory (IAgent, AgentHarness, ILessonStore, embeddings + LLM recall + tools).</Description>
    <PackageTags>agents;llm;memory;harness;azure-openai</PackageTags>
  </PropertyGroup>

  <!--
    THE GROWING-AGENT PATTERN, as code. Every S-agent references this library and implements IAgent
    (three methods). The fast loop, the reward contract, and the lesson memory live here ONCE and are
    never re-implemented per agent. See PATTERN.md at the repo root of agents/.
  -->

</Project>
