<?xml version="1.0" encoding="utf-8"?>
<!-- Scope package restore for the agents tree to public nuget.org only. Keeps the private
     org feed (which needs auth) out of the way so the harness restores cleanly anywhere. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
