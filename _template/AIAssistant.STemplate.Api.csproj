<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AIAssistant.STemplate</RootNamespace>
  </PropertyGroup>

  <!--
    COPY ME to build a new growing agent (S1..S6 were built exactly this way).
    1. Copy this folder to agents/sN.  2. Rename the csproj + Id + port + blockKey.
    3. Implement the three methods in TemplateAgent.cs.  4. dotnet run. Done.
    The loop, memory, host and reward-contract come from the shared libraries — you never touch them.
  -->

  <ItemGroup>
    <ProjectReference Include="..\shared\AIAssistant.AgentHost\AIAssistant.AgentHost.csproj" />
  </ItemGroup>

</Project>
